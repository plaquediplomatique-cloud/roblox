{
  "name": "AetherStrike",
  "globIgnorePaths": ["**/*.spec.luau", "**/.DS_Store"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "src/ReplicatedFirst"
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/Shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/Server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 4.4,
        "CharacterWalkSpeed": 16,
        "CharacterMaxSlopeAngle": 50,
        "LoadCharacterAppearance": false,
        "AutoJumpEnabled": false,
        "EnableMouseLockOption": false,
        "DevComputerMovementMode": "Scriptable",
        "DevTouchMovementMode": "Scriptable",
        "HealthDisplayDistance": 0,
        "NameDisplayDistance": 0,
        "CameraMaxZoomDistance": 12,
        "CameraMinZoomDistance": 0.5
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayerScripts",
        "Client": {
          "$path": "src/Client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$path": "src/StarterCharacterScripts"
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false,
        "ShowDevelopmentGui": true
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 96,
        "StreamingTargetRadius": 768,
        "StreamingIntegrityMode": "PauseOutsideLoadedArea",
        "SignalBehavior": "Deferred",
        "Gravity": 196.2,
        "FallenPartsDestroyHeight": -500
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true,
        "ShadowSoftness": 0.2,
        "GlobalShadows": true,
        "Brightness": 2,
        "ClockTime": 20.6,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "ExposureCompensation": 0,
        "Ambient": [0.07, 0.08, 0.1],
        "OutdoorAmbient": [0.16, 0.18, 0.22]
      }
    },

    "MaterialService": {
      "$className": "MaterialService",
      "$properties": {
        "Use2022Materials": true
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true,
        "AmbientReverb": "NoReverb",
        "DistanceFactor": 3.33,
        "RolloffScale": 1
      }
    }
  }
}
