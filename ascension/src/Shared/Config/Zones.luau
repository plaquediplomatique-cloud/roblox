--!strict
--[[
	Zones — 10 royaumes. Données uniquement : la géométrie, l'éclairage et les mannequins
	sont construits depuis ces valeurs (Server/Services/WorldService).

	* MinLevel      niveau requis ; UnlockCoins = péage unique (0 = gratuit)
	* WeaponOffsets niveaux (relatifs à MinLevel) auxquels les 6 armes de la zone se débloquent
	* Lighting      ambiance (ClockTime, couleurs, brouillard)
	* Palette       couleurs de décor (Ground, Accent, Prop, Sky)
	* Dummy         apparence/nom du mannequin ; Boss = boss de la zone
]]

export type Lighting = {
	ClockTime: number,
	Ambient: Color3,
	OutdoorAmbient: Color3,
	FogColor: Color3,
	FogEnd: number,
	Brightness: number,
	Tint: Color3,
}

export type Zone = {
	Id: string,
	Index: number,
	Name: string,
	Tagline: string,
	MinLevel: number,
	UnlockCoins: number,
	WeaponOffsets: { number },
	Lighting: Lighting,
	Palette: { Ground: Color3, Accent: Color3, Prop: Color3, Sky: Color3, Glow: Color3 },
	Material: Enum.Material,
	DummyName: string,
	DummyColor: Color3,
	BossName: string,
	Music: string,
	Scatter: { string }, -- types de décors de nature/props répartis dans la zone
}

